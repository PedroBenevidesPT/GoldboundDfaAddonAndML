# Copy to .env and fill in.  .env is gitignored; this file is the template.
#
# The pipeline reads .env via python-dotenv, and docker compose reads it for
# variable substitution.  Nothing here is a secret in the template.

# PostHog configuration
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://your-posthog-host

# --- Blizzard API ---------------------------------------------------------
# Required by the fetcher.  Create at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# --- Alerts (optional) ----------------------------------------------------
# Discord webhook for the new-dataset alert.
DISCORD_WEBHOOK=
# The TSM / Undermine Exchange API key used by the price import.
UNDERMINE_EXCHANGE_APIKEY=

# --- The shared base ------------------------------------------------------
# Set these to run against the Postgres stack instead of data/intel.sqlite.
# On the host, point at the published port.  Inside compose the worker gets
# the service name automatically, so these are only needed outside Docker.
DATABASE_URL=postgresql://goldbound:goldbound@localhost:5432/goldbound
WOW_PIPELINE_BACKEND=postgres

# Optional: mirror lease/stat updates to Redis.  The pipeline runs without it.
WOW_PIPELINE_REDIS=redis://localhost:6379/0

# --- compose --------------------------------------------------------------
# Offset from the defaults so a local Postgres/Redis install does not collide.
POSTGRES_DB=goldbound
POSTGRES_USER=goldbound
POSTGRES_PASSWORD=goldbound
POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@goldbound.io
PGADMIN_PASSWORD=goldbound
